<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SM2Customizer</RootNamespace>
    <AssemblyName>SM2Customizer</AssemblyName>
    <ApplicationTitle>Space Marine 2 Customizer</ApplicationTitle>
    <Version>1.0.0</Version>
    <Authors>SM2Customizer</Authors>
    <Company>SM2Customizer</Company>
    <Product>Space Marine 2 Customizer</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Web\**\*" />
  </ItemGroup>

</Project>
