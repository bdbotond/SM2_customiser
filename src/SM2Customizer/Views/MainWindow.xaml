<Window x:Class="SM2Customizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Warhammer 40,000: Space Marine 2 — Astartes 3D Armouring Studio"
        Height="860" Width="1400"
        MinHeight="720" MinWidth="1100"
        Background="{DynamicResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Unified Studio Ribbon -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Width="30" Height="30" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource GoldAccentBrush}" BorderThickness="1.5" CornerRadius="4" Margin="0,0,10,0">
                        <TextBlock Text="⚔" FontSize="16" Foreground="{DynamicResource GoldAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WARHAMMER 40,000: SPACE MARINE 2" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}"/>
                        <TextBlock Text="Astartes Armouring Studio" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Game Directory Pill -->
                <Border Grid.Column="1" Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="620">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GAME PATH" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                        <TextBox x:Name="TxtGamePath" Grid.Column="1" VerticalAlignment="Center" Padding="4,2" FontSize="11" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                        <Button x:Name="BtnBrowse" Grid.Column="2" Content="Browse" Style="{DynamicResource MicroButtonStyle}" Margin="6,0,0,0" Click="BtnBrowse_Click"/>
                        <Button x:Name="BtnAutoDetect" Grid.Column="3" Content="Auto-Detect" Style="{DynamicResource MicroButtonStyle}" Margin="4,0,0,0" Click="BtnAutoDetect_Click"/>
                        <Button x:Name="BtnReload" Grid.Column="4" Content="Reload" Style="{DynamicResource MicroButtonStyle}" Margin="4,0,0,0" Click="BtnReload_Click"/>
                    </Grid>
                </Border>

                <!-- Action Primary Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleTheme" Content="🌙 Dark Mode" Style="{DynamicResource SecondaryButtonStyle}" Click="BtnToggleTheme_Click" ToolTip="Toggle Dark/Light Mode Theme"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Studio Split View (Left: 3D Viewport, Right: Customizer Tabs) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColViewport" Width="55*" MinWidth="420"/>
                <ColumnDefinition x:Name="ColSplitter" Width="6"/>
                <ColumnDefinition x:Name="ColCustomizer" Width="45*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: 3D Interactive Viewport -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- WebView2 Hosting Three.js 3D Viewport -->
                    <wv2:WebView2 x:Name="Wv3DViewport" Grid.Row="0"/>

                    <!-- Bottom 3D Toolbar Dock -->
                    <Border Grid.Row="1" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="BtnImportModel" Content="Import Custom 3D Mesh (.obj)" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnImportModel_Click"/>
                                <Button x:Name="BtnTogglePanel" Content="[◄ Fullscreen 3D]" Style="{DynamicResource SecondaryButtonStyle}" Click="BtnTogglePanel_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock Text="Grimdark Armouring Bay (Three.js PBR)" Foreground="{DynamicResource GoldAccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" Cursor="SizeWE"/>

            <!-- Column 2: Customization Tabs (UE5 Property Inspector Style) -->
            <TabControl x:Name="MainTabs" Grid.Column="2" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}">
                <!-- Tab 1: Armor Customizer -->
                <TabItem Header="Armor Customizer">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Class & Team Filter Strip -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Faction / Class / Preset Row -->
                                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <TextBlock Text="Faction:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource GoldAccentBrush}"/>
                                        <ComboBox x:Name="CmbTeam" Width="110" SelectionChanged="CmbTeam_SelectionChanged" Padding="8,4"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <TextBlock Text="Class:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource GoldAccentBrush}"/>
                                        <ComboBox x:Name="CmbClass" Width="135" SelectionChanged="CmbClass_SelectionChanged" Padding="8,4"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                        <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource GoldAccentBrush}"/>
                                        <ComboBox x:Name="CmbPreset" Width="150" SelectionChanged="CmbPreset_SelectionChanged" Padding="8,4"/>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Search & Cross-Class Filter Row -->
                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtArmorPieceSearch" Grid.Column="0" Padding="8,4" Background="{DynamicResource ControlBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" TextChanged="TxtArmorPieceSearch_TextChanged" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ChkCrossClassFilter" Grid.Column="1" Content="Allow Cross-Class Pieces" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0" Checked="ChkCrossClassFilter_Changed" Unchecked="ChkCrossClassFilter_Changed"/>
                                </Grid>

                                <!-- Quick Preset Actions Strip -->
                                <Border Grid.Row="2" Margin="0,7,0,0" Padding="8,5" Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="Quick Actions:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                            <Button x:Name="BtnQuickReset" Content="⟲ Reset Preset" Style="{DynamicResource MicroButtonStyle}" Margin="0,0,6,0" Click="BtnQuickReset_Click" ToolTip="Reset all slots to currently selected class preset"/>
                                            <Button x:Name="BtnQuickRandomize" Content="🎲 Randomize" Style="{DynamicResource MicroButtonStyle}" Margin="0,0,6,0" Click="BtnQuickRandomize_Click" ToolTip="Randomize armor pieces across available legitimate pieces"/>
                                            <Button x:Name="BtnQuickClearAll" Content="✕ Clear All" Style="{DynamicResource MicroButtonStyle}" Click="BtnQuickClearAll_Click" ToolTip="Unequip all 3D armor pieces"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Categorized Armor Slots List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsArmorSlots">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4" Padding="10,6" Margin="0,8,0,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource GoldAccentBrush}" CornerRadius="1.5"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource GoldAccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Slot Header & Focus -->
                                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text="{Binding SectionKey}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="Focus 3D"
                                                            Tag="{Binding SectionKey}"
                                                            Click="BtnFocusSlot_Click"
                                                            Style="{DynamicResource MicroButtonStyle}"
                                                            Padding="8,2"
                                                            VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Piece Selector ComboBox -->
                                                <ComboBox Grid.Row="1"
                                                          ItemsSource="{Binding AvailablePieces}"
                                                          SelectedItem="{Binding SelectedPiece, Mode=TwoWay}"
                                                          SelectedValuePath="Uid"
                                                          SelectionChanged="SlotPiece_SelectionChanged"
                                                          Padding="8,5">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="2,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                                <Border Grid.Column="1" CornerRadius="3" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{Binding TierColor}" BorderThickness="1" Padding="5,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TierBadge}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding TierColor}"/>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Paints & Shaders -->
                <TabItem Header="Paints &amp; Shaders">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Colors List -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Target Part Selector & Search -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="Target Armor Part:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource GoldAccentBrush}" Margin="1,0,0,3"/>
                                    <ComboBox x:Name="CmbColorTarget" SelectionChanged="CmbColorTarget_SelectionChanged" Padding="6,4">
                                        <ComboBoxItem Content="All Parts (Full Marine)" IsSelected="True" Tag="ALL"/>
                                        <ComboBoxItem Content="Helmet" Tag="HELMET"/>
                                        <ComboBoxItem Content="Torso / Cuirass" Tag="CHEST"/>
                                        <ComboBoxItem Content="Power Pack" Tag="BACKPACK"/>
                                        <ComboBoxItem Content="Left Pauldron" Tag="LEFT_PAULDRON"/>
                                        <ComboBoxItem Content="Right Pauldron" Tag="RIGHT_PAULDRON"/>
                                        <ComboBoxItem Content="Both Pauldrons" Tag="BOTH_PAULDRONS"/>
                                        <ComboBoxItem Content="Left Gauntlet &amp; Arm" Tag="LEFT_GAUNTLET"/>
                                        <ComboBoxItem Content="Right Gauntlet &amp; Arm" Tag="RIGHT_GAUNTLET"/>
                                        <ComboBoxItem Content="Both Arms" Tag="BOTH_ARMS"/>
                                        <ComboBoxItem Content="Left Greave &amp; Leg" Tag="LEFT_GREAVE"/>
                                        <ComboBoxItem Content="Right Greave &amp; Leg" Tag="RIGHT_GREAVE"/>
                                        <ComboBoxItem Content="Both Legs" Tag="BOTH_LEGS"/>
                                        <ComboBoxItem Content="Wargear &amp; Cloth" Tag="CLOTH"/>
                                    </ComboBox>
                                    <Button x:Name="BtnResetPartColor" Content="↺ Reset Part Color" Style="{DynamicResource MicroButtonStyle}" Margin="0,4,0,6" Click="BtnResetPartColor_Click" ToolTip="Reset selected armor part back to global color"/>
                                    <TextBox x:Name="TxtColorSearch" Padding="6,4" TextChanged="TxtColorSearch_TextChanged" Background="{DynamicResource ControlBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                                </StackPanel>
                                <ListBox x:Name="LstColors" Grid.Row="1" SelectionChanged="LstColors_SelectionChanged" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="1,2" Padding="6,4" CornerRadius="4" Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3" Background="{Binding HexColor}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text="{Binding HexColor}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="MET" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMetallic}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button x:Name="BtnAddCustomColor" Grid.Row="2" Content="+ New Color" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,6,0,0" Click="BtnAddCustomColor_Click"/>
                            </Grid>
                        </Border>

                        <!-- Color Editor Panel -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlColorEditor" IsEnabled="False">
                                    <TextBlock Text="PBR Material Properties" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Color Name:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtColorId" Grid.Column="1" Padding="6,4" Background="{DynamicResource ControlBgBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" TextChanged="TxtColorId_TextChanged"/>
                                        <Border x:Name="BrdColorPreview" Grid.Column="2" Height="28" Width="60" Margin="8,0,0,0" CornerRadius="4" BorderBrush="{DynamicResource GoldAccentBrush}" BorderThickness="1.5">
                                            <TextBlock x:Name="TxtColorHexPreview" Text="#FFFFFF" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="#000000"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <CheckBox x:Name="ChkIsMetallic" Content="Metallic Finish (isMetallic = True)" FontWeight="Bold" Margin="0,0,0,12" Checked="ColorSlider_ValueChanged" Unchecked="ColorSlider_ValueChanged"/>

                                    <TextBlock Text="Primary Plate Tint (RGB)" FontWeight="SemiBold" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="R" FontWeight="Bold" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldR" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="ColorSlider_ValueChanged"/>
                                        <TextBlock x:Name="LblR" Grid.Column="2" Text="255" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="G" FontWeight="Bold" Foreground="#51CF66" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldG" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="ColorSlider_ValueChanged"/>
                                        <TextBlock x:Name="LblG" Grid.Column="2" Text="255" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="B" FontWeight="Bold" Foreground="#339AF0" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldB" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="ColorSlider_ValueChanged"/>
                                        <TextBlock x:Name="LblB" Grid.Column="2" Text="255" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="Specular / Metalness Highlight Tint" FontWeight="SemiBold" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="R" FontWeight="Bold" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldSpecR" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="ColorSlider_ValueChanged"/>
                                        <TextBlock x:Name="LblSpecR" Grid.Column="2" Text="255" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="G" FontWeight="Bold" Foreground="#51CF66" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldSpecG" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="ColorSlider_ValueChanged"/>
                                        <TextBlock x:Name="LblSpecG" Grid.Column="2" Text="255" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="B" FontWeight="Bold" Foreground="#339AF0" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldSpecB" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="ColorSlider_ValueChanged"/>
                                        <TextBlock x:Name="LblSpecB" Grid.Column="2" Text="255" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 3: Decals & Patterns -->
                <TabItem Header="Decals &amp; Patterns">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Decals -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Chapter &amp; Tactical Decals" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,0,6"/>
                                <DataGrid x:Name="GridDecals" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" Foreground="{DynamicResource TextBrush}" RowBackground="{DynamicResource CardBgBrush}" AlternatingRowBackground="{DynamicResource CardHeaderBrush}" SelectionChanged="GridDecals_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="110" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Decal Name" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Layers" Binding="{Binding ColorsNumber}" Width="50"/>
                                        <DataGridTextColumn Header="Primary Color" Binding="{Binding PrimaryColor}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Patterns -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Armor Patterns (Split Schemes / Chevrons)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,0,6"/>
                                <DataGrid x:Name="GridPatterns" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" Foreground="{DynamicResource TextBrush}" RowBackground="{DynamicResource CardBgBrush}" AlternatingRowBackground="{DynamicResource CardHeaderBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Pattern Name" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="Enable for All Classes" Binding="{Binding EnabledForEveryone}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 4: Global Unlocks & Presets -->
                <TabItem Header="Unlocks &amp; Presets">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Unlocks Box -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Automatic Game Unlocks" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkUnlockCrossClass" Content="Unlock All Restricted Armor Slots Across All Classes" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkUnlockAllColors" Content="Unlock All Colors and Decals Instantly (Zero Requisition Points)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkUnlockAllPatterns" Content="Unlock All Armor Split Patterns for All Classes" IsChecked="True" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Presets Box -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Custom Marine Presets (.json)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource GoldAccentBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Save your customized marine loadouts to share or load previously saved presets." Margin="0,0,0,10" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="BtnSavePreset" Content="Save Preset to File..." Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnSavePreset_Click"/>
                                    <Button x:Name="BtnLoadPreset" Content="Load Preset from File..." Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnLoadPreset_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Ready. Please select your Space Marine 2 game folder." Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="SM2 Mod Studio v2.0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
